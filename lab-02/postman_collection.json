{
  "info": {
    "_postman_id": "bdf-lab-02-sqlite-crud",
    "name": "BDF Lab 2 - SQLite Database and CRUD Routes",
    "description": "Postman Collection for Lab 2: SQLite Database & Express CRUD Endpoints.\nStudent: B. UDAY SAI SRIMAN (252U1R8005)\nCourse: Backend Development Fundamentals",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Root - API Information",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/",
          "host": ["{{baseUrl}}"],
          "path": [""]
        },
        "description": "Root endpoint returning student details, course info, and endpoint list."
      },
      "response": []
    },
    {
      "name": "1. GET All Books",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/books/",
          "host": ["{{baseUrl}}"],
          "path": ["books", ""]
        },
        "description": "Retrieve all book records from SQLite database ordered by ID."
      },
      "response": []
    },
    {
      "name": "2. GET Single Book by ID",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/books/1/",
          "host": ["{{baseUrl}}"],
          "path": ["books", "1", ""]
        },
        "description": "Retrieve single book details for ID 1."
      },
      "response": []
    },
    {
      "name": "3. GET Non-Existent Book (404 Not Found)",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/books/999/",
          "host": ["{{baseUrl}}"],
          "path": ["books", "999", ""]
        },
        "description": "Edge case test: querying a book ID that does not exist in the database."
      },
      "response": []
    },
    {
      "name": "4. GET Invalid Book ID (400 Bad Request)",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/books/invalid-id/",
          "host": ["{{baseUrl}}"],
          "path": ["books", "invalid-id", ""]
        },
        "description": "Edge case test: non-numeric string passed as book ID parameter."
      },
      "response": []
    },
    {
      "name": "5. POST Insert New Book",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"title\": \"Clean Architecture: A Craftsman's Guide to Software Structure\",\n  \"author\": \"Robert C. Martin\",\n  \"price\": 750,\n  \"pages\": 432\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/books/",
          "host": ["{{baseUrl}}"],
          "path": ["books", ""]
        },
        "description": "Insert a new book record with parameterized SQL query."
      },
      "response": []
    },
    {
      "name": "6. POST Missing Fields (400 Validation Error)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"title\": \"Incomplete Book\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/books/",
          "host": ["{{baseUrl}}"],
          "path": ["books", ""]
        },
        "description": "Edge case test: missing author, price, and pages attributes in request body."
      },
      "response": []
    },
    {
      "name": "7. PUT Update Book Details",
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"title\": \"Clean Code: Special Revised Edition\",\n  \"author\": \"Robert C. Martin\",\n  \"price\": 699,\n  \"pages\": 475\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/books/1/",
          "host": ["{{baseUrl}}"],
          "path": ["books", "1", ""]
        },
        "description": "Update existing book attributes for book ID 1."
      },
      "response": []
    },
    {
      "name": "8. PUT Non-Existent Book (404 Not Found)",
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"title\": \"Ghost Book\",\n  \"author\": \"Anonymous\",\n  \"price\": 100,\n  \"pages\": 50\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/books/999/",
          "host": ["{{baseUrl}}"],
          "path": ["books", "999", ""]
        },
        "description": "Edge case test: updating a non-existent book returns 404."
      },
      "response": []
    },
    {
      "name": "9. DELETE Book by ID",
      "request": {
        "method": "DELETE",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/books/10/",
          "host": ["{{baseUrl}}"],
          "path": ["books", "10", ""]
        },
        "description": "Delete book record with ID 10 from SQLite database."
      },
      "response": []
    },
    {
      "name": "10. DELETE Non-Existent Book (404 Not Found)",
      "request": {
        "method": "DELETE",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/books/999/",
          "host": ["{{baseUrl}}"],
          "path": ["books", "999", ""]
        },
        "description": "Edge case test: deleting a non-existent book returns 404."
      },
      "response": []
    }
  ]
}
